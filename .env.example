# Copy to .env in this same directory, fill in, then restart the dev server.
#
# Vite reads this directory via `envDir: '..'` in frontend/vite.config.ts, so the
# frontend's config lives here rather than under frontend/.
#
# Only VITE_-prefixed vars reach the browser bundle. Anything without that prefix
# stays out of the client build — put backend secrets here, not there.

# Supabase (Authentication -> Providers -> Google must be enabled)
# The anon key is Supabase's public client key: it ships inside the JS bundle and
# is protected by row-level security. The service_role key must never go here.
# Project Settings -> API.
VITE_SUPABASE_URL=https://telssixwqcboqxodcsvt.supabase.co
VITE_SUPABASE_ANON_KEY=

# Mapbox GL draws the map in frontend/src/components/GrassMap.tsx. Without a
# token the map renders blank and logs to the console. account.mapbox.com.
VITE_MAPBOX_TOKEN=

# FastAPI -> Supabase Postgres. Unset, the backend falls back to local SQLite,
# which is enough to run everything except shared state.
#
# Use the *pooler* host, not db.<ref>.supabase.co — the direct host is IPv6-only
# and unreachable from IPv4-only networks. Project Settings -> Database ->
# Connection string -> Session pooler. Port 5432 (session mode) suits
# SQLAlchemy's own pooling; 6543 (transaction mode) breaks prepared statements.
#
# This user bypasses row-level security. Never commit the filled-in .env.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Gemini judges grass photos when set; otherwise the local CV heuristic judges
# alone. aistudio.google.com/apikey.
GEMINI_API_KEY=

# Backend -> Supabase Storage for submission photos (Project Settings -> API ->
# service_role). Server-side secret: bypasses RLS, never expose to the browser.
# Unset = photos fall back to local disk under backend/uploads/.
# The bucket is created automatically on first upload if it doesn't exist.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=grass-photos
