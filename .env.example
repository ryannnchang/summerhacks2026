# Copy to .env in this same directory, fill in, then restart the dev server.
#
# Vite reads this directory via `envDir: '..'` in frontend/vite.config.ts, so the
# frontend's config lives here rather than under frontend/.
#
# Only VITE_-prefixed vars reach the browser bundle. Anything without that prefix
# stays out of the client build — put backend secrets here, not there.

# Supabase (Authentication -> Providers -> Google must be enabled)
# The anon key is Supabase's public client key: it ships inside the JS bundle and
# is protected by row-level security. The service_role key must never go here.
VITE_SUPABASE_URL=https://telssixwqcboqxodcsvt.supabase.co
VITE_SUPABASE_ANON_KEY=
