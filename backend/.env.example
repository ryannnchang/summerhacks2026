# Copy to .env and tweak. Everything here has a sane default in app/config.py.

# DATABASE_URL=sqlite:///./grass.db

# How long a drop stays open once it fires (seconds)
DROP_WINDOW_SECONDS=900

# Random gap between drops (seconds) — tighten these for demo day
DROP_MIN_GAP_SECONDS=3600
DROP_MAX_GAP_SECONDS=21600

# Grass verification thresholds
MIN_GRASS_COVERAGE=0.25
MIN_TEXTURE_SCORE=0.05

# Mural grid width in tiles
MURAL_COLUMNS=24
