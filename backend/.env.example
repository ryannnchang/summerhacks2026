# Copy to .env and tweak. Everything here has a sane default in app/config.py.

# DATABASE_URL=sqlite:///./grass.db

# How long a drop stays open once it fires (seconds)
DROP_WINDOW_SECONDS=900

# Random gap between drops (seconds) — tighten these for demo day
DROP_MIN_GAP_SECONDS=3600
DROP_MAX_GAP_SECONDS=21600

# Grass verification thresholds (local CV heuristic)
MIN_GRASS_COVERAGE=0.25
MIN_TEXTURE_SCORE=0.05

# Gemini vision judging. Set a key (https://aistudio.google.com/apikey) and
# Gemini becomes the judge — authenticity gate, lushness/biodiversity scoring,
# glyph features. Leave unset and the CV heuristic judges alone. If a Gemini
# call fails at runtime, the heuristic silently takes over for that submission.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=25

# Mural grid width in tiles
MURAL_COLUMNS=24
